# Copiar a .env y ajustar
JWT_SECRET=cambiar-esto-en-produccion
JWT_EXPIRE_MINUTES=480
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
CORS_ORIGINS=http://localhost:5180
GEMINI_API_KEY=
SEED_ON_EMPTY=true
# DATABASE_URL=sqlite:///ruta/absoluta/micronegocio.db  (por defecto backend/data/micronegocio.db)
GEMINI_MODEL=gemini-2.5-flash
APRIORI_MIN_SUPPORT=0.02
APRIORI_MIN_CONFIDENCE=0.3
APRIORI_MIN_LIFT=1.2
DEMANDA_TEST_DIAS=30
